<?php

use Krystal\Form\Element;
use Krystal\Widget\GridView\GridViewWidget;
use Cms\View\Icon;

?>

<div class="btn-toolbar mb-3">
	<div class="dropdown">
	  <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
		<i class="bi bi-list-ul"></i> <?= $this->translate('Menu'); ?>
	  </button>

	  <div class="dropdown-menu">
         <?php if (isset($albumId)): ?>
		 <a class="dropdown-item" href="<?= $this->url('Photogallery:Admin:Browser@indexAction'); ?>"><i class="bi bi-house"></i> <?= $this->translate('Go home'); ?></a>
		 <div class="dropdown-divider"></div>
         <?php endif; ?>
		 <a class="dropdown-item" href="<?= $this->url('Photogallery:Admin:Photo@addAction'); ?>"><i class="bi bi-image"></i> <?= $this->translate('Add a photo'); ?></a>
		 <a class="dropdown-item" href="<?= $this->url('Photogallery:Admin:Album@addAction'); ?>"><i class="bi bi-folder2-open"></i> <?= $this->translate('Add album'); ?></a>
		 <a class="dropdown-item" href="<?= $this->url('Photogallery:Admin:Config@indexAction'); ?>"><i class="bi bi-gear"></i> <?= $this->translate('Configuration'); ?></a>
		 <div class="dropdown-divider"></div>
		 <div class="dropdown-header"><?= $this->translate('Extra options'); ?></div>
		 <a class="dropdown-item" href="<?= $this->url('Photogallery:Admin:Photo@batchFormAction'); ?>"><i class="bi bi-images"></i> <?= $this->translate('Batch photo uploading'); ?></a>
		 <div class="dropdown-divider"></div>
		 <div class="dropdown-header"><?= $this->translate('Actions'); ?></div>
		 <?php if (!empty($photos)): ?>
		 <a class="dropdown-item" href="#" data-button="save-changes" data-url="<?= $this->url('Photogallery:Admin:Photo@tweakAction'); ?>"><i class="bi bi-save"></i> <?= $this->translate('Save changes');?></a>
		 <a class="dropdown-item" href="#" data-button="remove-selected" data-url="<?= $this->url('Photogallery:Admin:Photo@deleteAction', null); ?>"><i class="bi bi-x-circle"></i> <?= $this->translate('Remove selected'); ?></a>
		 <?php else: ?>
		 <a class="dropdown-item disabled"><i class="bi bi-save"></i> <?= $this->translate('Save changes');?></a>
		 <a class="dropdown-item disabled"><i class="bi bi-x-circle"></i> <?= $this->translate('Remove selected'); ?></a>
		 <?php endif; ?>
	  </div>
	</div>
</div>

<div class="card card-body">
    <?php $this->loadPartial('items-per-page', ['caption' => 'Photogallery']); ?>

    <form>
        <div class="table-responsive">
            <?= $this->widget(new GridViewWidget($photos, [
                // A column to be considered as a primary key
                'pk' => 'id',
                'batch' => true,
                'tableClass' => 'table table-hover table-bordered table-striped table-sm',
                'columns' => [
                    [
                        'column' => 'id',
                        'label' => '#'
                    ],

                    [
                        'column' => 'image_bag',
                        'label' => 'Image',
                        'value' => function($photo){
                            return Element::image($photo->getImageBag()->getUrl('400x200'), [
                                'class' => 'img-fluid',
                                'data-zoom-image' => $photo->getImageBag()->getUrl('original')
                            ]);
                        }
                    ],

                    [
                        'column' => 'name'
                    ],

                    [
                        'column' => 'date'
                    ],

                    [
                        'column' => 'album_name',
                        'label' => 'Album'
                    ],

                    [
                        'column' => 'published',
                        'value' => function($photo){
                            return Element::checkbox(sprintf('published[%s]', $photo->getId()), $photo->getPublished(), ['class' => 'form-check-input']);
                        }
                    ],

                    [
                        'column' => 'order',
                        'value' => function($photo){
                            return Element::number(sprintf('order[%s]', $photo->getId()), $photo->getOrder(), ['class' => 'form-control', 'min' => '0']);
                        }
                    ]
                ],

                'actions' => [
                    function($photo){
                        return Icon::edit(
                            $this->url('Photogallery:Admin:Photo@editAction', $photo->getId()),
                            $this->translate('Edit the photo')
                        );
                    },

                    function($photo){
                        return Icon::remove(
                            $this->url('Photogallery:Admin:Photo@deleteAction', $photo->getId()), 
                            $this->translate('Remove this photo')
                        );
                    }
                ]

            ])); ?>

            <?php if (empty($photos)): ?>
            <div class="center-block">
                <h2 class="text-center text-muted"><i class="bi bi-x-circle"></i> <?= $this->translate('No photos'); ?></h2>
            </div>
            <?php endif; ?>
        </div>
    </form>

    <?php $this->loadPartial('paginator'); ?>
</div>

<div class="card card-body">
    <h4><i class="bi bi-list-ul"></i> <?= $this->translate('Albums'); ?> (<?= count($albums); ?>)</h4>

    <?= $this->widget(new GridViewWidget($albums, [
        'tableClass' => 'table table-hover table-bordered table-striped table-sm',
        'rowAttributes' => [
            'class' => function($album) use ($albumId){
                return $album['id'] == $albumId ? 'table-info' : null;
            }
        ],
        'columns' => [
            [
                'column' => 'id',
                'label' => '#'
            ],

            [
                'column' => 'name',
                'attributes' => [
                    // Cancel default column class
                    'class' => null
                ],
                'value' => function($album){
                    return Element::link($album['name'], $this->url('Photogallery:Admin:Browser@albumAction', $album['id']));
                }
            ],

            [
                'column' => 'photos_count',
                'label' => 'Amount of photos'
            ]
        ],

        'actions' => [
            function($album){
                return Icon::view(
                    $album['url'],
                    $this->translate('View this album on site')
                );
            },

            function($album){
                return Icon::edit(
                    $this->url('Photogallery:Admin:Album@editAction', $album['id']),
                    $this->translate('Edit the album')
                );
            },

            function($album){
                return Icon::remove(
                    $this->url('Photogallery:Admin:Album@deleteAction', $album['id']),
                    $this->translate('Remove the album')
                );
            }
        ]
    ])); ?>

    <?php if (empty($albums)): ?>
    <div class="center-block">
        <h2 class="text-center text-muted"><i class="bi bi-x-circle"></i> <?= $this->translate('No albums'); ?></h2>
    </div>
    <?php endif; ?>
</div>